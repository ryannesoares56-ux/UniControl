# ===================================================================
# UniControl — Arquivo de Variáveis de Ambiente de Exemplo
# ===================================================================
# Copie este arquivo para .env e preencha com as configurações do seu banco local.
# O arquivo .env real nunca deve ser commitado no repositório.

# Driver de banco de dados: "mysql" (padrão) ou "sqlite" (fallback local)
DB_DRIVER=mysql

# Host do banco de dados (ex.: localhost ou 127.0.0.1)
DB_HOST=127.0.0.1

# Porta do serviço MySQL (padrão MySQL: 3306)
DB_PORT=3306

# Nome do banco de dados que deve ser criado
DB_NAME=unicontrol_db

# Usuário do banco de dados
DB_USER=root

# Senha do banco de dados (deixe em branco se não houver senha no XAMPP)
DB_PASS=
